# ResQNet AI - Backend Production Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas URI (Replace with actual Production URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqnet_prod?retryWrites=true&w=majority

# JWT Security
# Generate a strong 64-character hex secret for production
JWT_SECRET=replace_with_strong_production_secret
JWT_EXPIRE=7d

# CORS Origin Configuration (Replace with Vercel URL)
# CORS_ORIGIN=https://resqnet-ai.vercel.app
